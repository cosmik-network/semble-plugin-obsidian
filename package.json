{
	"name": "semble-obsidian-plugin",
	"version": "0.7.1",
	"description": "Organize and interact with web links in your notes using Semble.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run",
		"preversion": "npm run lint && npm test",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"links"
	],
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@types/node": "^22.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.30.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"typescript": "~5.9.2",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.4"
	}
}
